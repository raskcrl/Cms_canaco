# Copia este archivo a .env y completa los valores reales.
# .env está ignorado por git y nunca debe subirse.

SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (Neon/PostgreSQL u otra)
DATABASE_URL=postgresql://usuario:password@host/base_de_datos?sslmode=require

# MySQL local (solo si no usas DATABASE_URL)
# DB_NAME=canaco
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
